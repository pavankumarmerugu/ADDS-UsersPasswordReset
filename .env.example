# Copy to .env and fill in. .env is git-ignored — keep it that way.
# In production prefer a real secret store (Kubernetes Secrets, AWS Secrets
# Manager, HashiCorp Vault, Azure Key Vault) over a file on disk.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be at least 32 characters. The app refuses to start without it.
SECRET_KEY=

# ldap  = talk LDAPS straight to a domain controller, bind as the user.
#         No privileged service account. Recommended.
# winrm = run Set-ADAccountPassword on a host with the AD management tools.
#         Needs a delegated service account, but also works for accounts whose
#         password has already expired. See docs/architecture.md.
AD_BACKEND=ldap

LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------
# Set BEHIND_PROXY=true when a reverse proxy terminates TLS in front of this
# service, otherwise every request looks like it comes from the proxy and
# per-IP rate limiting is useless. PROXY_HOPS = number of trusted proxies.
BEHIND_PROXY=true
PROXY_HOPS=1
FORCE_HTTPS=true

# Failed attempts only. A successful change does not consume quota.
RATE_LIMIT_PER_IP=10 per hour
RATE_LIMIT_PER_USER=5 per hour
# memory:// is per-worker and resets on restart. Use Redis for any deployment
# with more than one worker or replica, or the real limit is N x the configured
# value: RATE_LIMIT_STORAGE_URI=redis://redis:6379/0
RATE_LIMIT_STORAGE_URI=memory://

# ---------------------------------------------------------------------------
# Password pre-flight rules (Active Directory still has the final say)
# ---------------------------------------------------------------------------
PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_LENGTH=256
# AD's own complexity rule is 3 of 4 categories: lower, upper, digit, symbol.
PASSWORD_MIN_CLASSES=3
PASSWORD_FORBID_USERNAME=true
PASSWORD_FORBID_OLD=true

# ---------------------------------------------------------------------------
# AD_BACKEND=ldap
# ---------------------------------------------------------------------------
# Use a hostname, not an IP: the LDAPS certificate is validated against it.
LDAP_SERVER=dc01.corp.example.com
LDAP_PORT=636
LDAP_USE_SSL=true
# PEM bundle for the CA that issued your domain controllers' certificates.
LDAP_CA_CERT_FILE=/certs/ad-ca.pem
LDAP_VALIDATE_CERT=true
LDAP_BASE_DN=DC=corp,DC=example,DC=com
# Users sign in as <username>@<LDAP_UPN_SUFFIX>
LDAP_UPN_SUFFIX=corp.example.com
LDAP_CONNECT_TIMEOUT=10

# ---------------------------------------------------------------------------
# AD_BACKEND=winrm
# ---------------------------------------------------------------------------
# HTTPS only. Port 5985 is cleartext and is rejected by the config loader.
WINRM_ENDPOINT=https://adtools01.corp.example.com:5986/wsman
# ntlm | kerberos | certificate | basic
WINRM_AUTH=ntlm
# A dedicated, non-admin account delegated ONLY "Reset password" and
# "Change password" on the target OU. See docs/ad-delegation.md.
WINRM_USERNAME=CORP\svc-sspr
WINRM_PASSWORD=
WINRM_CA_CERT_FILE=/certs/winrm-ca.pem
WINRM_VALIDATE_CERT=true
WINRM_READ_TIMEOUT=30
WINRM_OPERATION_TIMEOUT=20
